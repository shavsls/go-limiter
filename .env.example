# Application
APP_VERSION=1.1.0
APP_ENV=development
PORT=8080

# Redis
# Local dev:  localhost:6379
# Docker:     redis:6379
REDIS_ADDR=localhost:6379

# Rate Limiter
# RATE_LIMIT        – max requests allowed per window (default: 5)
# RATE_LIMIT_WINDOW – sliding window duration, e.g. 30s, 1m, 5m (default: 30s)
RATE_LIMIT=5
RATE_LIMIT_WINDOW=30s
